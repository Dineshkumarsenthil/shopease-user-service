  "item": [
    {
      "name": "Setup (Authentication Service must be running on 8001)",
      "item": [
        {
          "name": "S1 Register user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/register",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"User A\",\n  \"email\": \"usera@example.com\",\n  \"password\": \"Strong@123\",\n  \"confirm_password\": \"Strong@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201/409', () => pm.expect(pm.response.code === 201 || pm.response.code === 409).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "S2 Register user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/register",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"User B\",\n  \"email\": \"userb@example.com\",\n  \"password\": \"Strong@123\",\n  \"confirm_password\": \"Strong@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201/409', () => pm.expect(pm.response.code === 201 || pm.response.code === 409).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "S3 Login user A (saves token_a)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usera@example.com\",\n  \"password\": \"Strong@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code === 200).to.be.true);",
                  "pm.collectionVariables.set('token_a', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "S4 Login user B (saves token_b)",
          "request": {
            "method": "POST",
            "header": [
              {
