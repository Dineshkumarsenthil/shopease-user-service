    {
      "key": "base_url",
      "value": "http://localhost:8002"
    },
    {
      "key": "auth_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "token_a",
      "value": ""
    },
    {
      "key": "token_b",
      "value": ""
    },
    {
      "key": "address_a1",
      "value": ""
    },
    {
      "key": "address_a2",
      "value": ""
