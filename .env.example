# Copy to .env and change every value. NEVER commit .env
MYSQL_ROOT_PASSWORD=ChangeMe_Root_456
MYSQL_DATABASE=shopease_user_db
MYSQL_USER=user_svc
MYSQL_PASSWORD=ChangeMe_User_456

# MUST be exactly the same JWT_SECRET_KEY and JWT_ALGORITHM as in shopease-auth-service/.env
JWT_SECRET_KEY=paste-the-same-secret-used-by-the-auth-service
JWT_ALGORITHM=HS256

# Authentication Service location (Auth runs on host port 8001)
AUTH_SERVICE_URL=http://host.docker.internal:8001
